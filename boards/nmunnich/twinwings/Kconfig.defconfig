if BOARD_TWINWINGS_LEFT

config BOARD
    default "TwinWings Left"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if BOARD_TWINWINGS_RIGHT

config BOARD
    default "TwinWings Right"

endif

if BOARD_TWINWINGS_LEFT || BOARD_TWINWINGS_RIGHT

config ZMK_SPLIT
    default y

config BT_CTLR
    default BT

config PINCTRL
    default y

if USB

config USB_NRFX
    default y

config USB_DEVICE_STACK
    default y

endif

endif
